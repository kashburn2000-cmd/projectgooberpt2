---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import AdSlot from "../../components/AdSlot.astro";
import { PLUG_TYPES, ALL_PLUG_IDS } from "../../data/plugTypes";
import { COUNTRIES } from "../../data/countries";
import { breadcrumbLd } from "../../lib/seo";

const counts = Object.fromEntries(
  ALL_PLUG_IDS.map((id) => [id, COUNTRIES.filter((c) => c.plugs.includes(id)).length]),
);
const jsonLd = [
  breadcrumbLd([{ name: "Home", path: "/" }, { name: "Plug types", path: "/plug-types" }]),
];
---

<Base
  title="The 14 Plug & Socket Types (A–N) — Complete Guide"
  description="Every electrical plug and socket type in the world, A to N: what they look like, where they're used, which are grounded, and which plugs fit which sockets."
  image="/og/plug.png"
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-4xl px-4">
    <Breadcrumbs items={[{ name: "Home", path: "/" }, { name: "Plug types" }]} />
    <h1 class="text-balance text-3xl font-extrabold tracking-tight sm:text-4xl">
      The 14 plug & socket types, A to N
    </h1>
    <p class="mt-3 max-w-2xl text-lg text-muted">
      The IEC recognises 14 domestic plug and socket types worldwide. Here's what
      each looks like, where it's used, and what fits it.
    </p>

    <AdSlot slot="" />

    <div class="mt-6 grid gap-3 sm:grid-cols-2">
      {
        ALL_PLUG_IDS.map((id) => {
          const t = PLUG_TYPES[id];
          return (
            <a href={`/plug-types/${id.toLowerCase()}`} class="card flex gap-4 hover:border-brand-400">
              <span class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-brand-600/10 font-mono text-xl font-bold text-brand-600 dark:text-brand-300">
                {id}
              </span>
              <span class="min-w-0">
                <span class="font-semibold">Type {id}</span>
                <span class="block text-sm text-muted">{t.standard}</span>
                <span class="mt-1 block text-xs text-muted">
                  {t.grounded ? "Grounded" : "Ungrounded"} · {counts[id]} countries
                </span>
              </span>
            </a>
          );
        })
      }
    </div>

    <section class="mt-10 rounded-2xl border border-border bg-surface p-6">
      <h2 class="text-xl font-bold tracking-tight">Plug shape and voltage are not the same thing</h2>
      <p class="mt-2 text-muted">
        A plug type only tells you the physical shape of the pins. It says nothing
        about voltage — two countries can share Type C yet run different voltages.
        That's why a plug adapter (shape) and a voltage converter (electricity) are
        two different tools. Use the
        <a href="/" class="prose-link">route checker</a> to see what your specific
        trip needs.
      </p>
    </section>
  </div>
</Base>

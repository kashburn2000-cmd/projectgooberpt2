---
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import AdSlot from "../components/AdSlot.astro";
import { countriesByRegion, COUNTRIES } from "../data/countries";
import { flag } from "../lib/util";
import { breadcrumbLd } from "../lib/seo";

const groups = countriesByRegion();
const jsonLd = [
  breadcrumbLd([
    { name: "Home", path: "/" },
    { name: "Countries", path: "/countries" },
  ]),
];
---

<Base
  title="Power Plugs & Voltage by Country — All 218 Countries"
  description="Plug type, voltage and frequency for every country in the world. Find the travel adapter you need for any destination — from Afghanistan to Zimbabwe."
  image="/og/country.png"
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-5xl px-4">
    <Breadcrumbs items={[{ name: "Home", path: "/" }, { name: "Countries" }]} />
    <h1 class="text-balance text-3xl font-extrabold tracking-tight sm:text-4xl">
      Power plugs & voltage in every country
    </h1>
    <p class="mt-3 max-w-2xl text-lg text-muted">
      Plug type, voltage and frequency for all {COUNTRIES.length} countries.
      Tap any country for the full adapter and converter guide.
    </p>

    <div class="mt-6">
      <label class="relative block">
        <span class="sr-only">Filter countries</span>
        <input
          id="country-filter"
          type="search"
          placeholder="Filter countries…"
          autocomplete="off"
          class="w-full rounded-xl border border-border bg-surface px-4 py-3 pl-10 shadow-sm focus:border-brand-500"
        />
        <svg class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-muted" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      </label>
      <p id="filter-empty" hidden class="mt-4 text-muted">No countries match that search.</p>
    </div>

    <AdSlot slot="" />

    {
      groups.map((g) => (
        <section class="mt-8 region-group" data-region={g.region}>
          <h2 class="text-xl font-bold tracking-tight">{g.region}</h2>
          <div class="mt-3 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
            {g.countries.map((c) => (
              <a
                href={`/country/${c.slug}`}
                class="country-item flex items-center justify-between gap-2 rounded-xl border border-border bg-surface px-4 py-2.5 hover:border-brand-400"
                data-name={c.name.toLowerCase()}
              >
                <span class="truncate font-medium">
                  <span class="mr-1">{flag(c.code)}</span>
                  {c.name}
                </span>
                <span class="shrink-0 font-mono text-xs text-muted">
                  {c.plugs.join("/")} · {c.voltage}V
                </span>
              </a>
            ))}
          </div>
        </section>
      ))
    }
  </div>

  <script is:inline>
    (function () {
      var input = document.getElementById("country-filter");
      if (!input) return;
      var items = Array.prototype.slice.call(document.querySelectorAll(".country-item"));
      var groups = Array.prototype.slice.call(document.querySelectorAll(".region-group"));
      var empty = document.getElementById("filter-empty");
      input.addEventListener("input", function () {
        var q = input.value.trim().toLowerCase();
        var any = false;
        items.forEach(function (el) {
          var match = !q || el.getAttribute("data-name").indexOf(q) !== -1;
          el.hidden = !match;
          if (match) any = true;
        });
        groups.forEach(function (g) {
          var visible = g.querySelectorAll(".country-item:not([hidden])").length;
          g.hidden = visible === 0;
        });
        if (empty) empty.hidden = any;
      });
    })();
  </script>
</Base>

---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import AdSlot from "../../components/AdSlot.astro";
import {
  COUNTRY_BY_CODE,
  POPULAR_ORIGIN_CODES,
  popularDestinations,
} from "../../data/countries";
import { flag } from "../../lib/util";
import { breadcrumbLd } from "../../lib/seo";

const origins = POPULAR_ORIGIN_CODES.map((c) => COUNTRY_BY_CODE.get(c)!).filter(Boolean);
const dests = popularDestinations();
const jsonLd = [
  breadcrumbLd([{ name: "Home", path: "/" }, { name: "Routes", path: "/adapter" }]),
];
---

<Base
  title="Travel Adapter Routes — By Country of Origin"
  description="Pick where you're travelling from and to for a country-to-country adapter and voltage verdict. Popular routes from the US, UK, Canada, Australia, Germany, France and India."
  image="/og/route.png"
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-5xl px-4">
    <Breadcrumbs items={[{ name: "Home", path: "/" }, { name: "Routes" }]} />
    <h1 class="text-balance text-3xl font-extrabold tracking-tight sm:text-4xl">
      Adapter guides by route
    </h1>
    <p class="mt-3 max-w-2xl text-lg text-muted">
      Every guide checks plug fit and voltage for your exact country-to-country trip.
      Start from your home country below, or
      <a href="/" class="prose-link">use the route checker</a>.
    </p>

    <AdSlot slot="" />

    {
      origins.map((o) => (
        <section class="mt-8">
          <h2 class="text-xl font-bold tracking-tight">{flag(o.code)} From {o.name}</h2>
          <div class="mt-3 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
            {dests
              .filter((d) => d.code !== o.code)
              .map((d) => (
                <a
                  href={`/adapter/${o.slug}-to-${d.slug}`}
                  class="flex items-center justify-between rounded-xl border border-border bg-surface px-4 py-2.5 text-sm hover:border-brand-400"
                >
                  <span>{o.name} → {flag(d.code)} {d.name}</span>
                  <span aria-hidden="true" class="text-muted">→</span>
                </a>
              ))}
          </div>
        </section>
      ))
    }

    <p class="mt-8 text-sm text-muted">
      Looking for a country not listed? Open any
      <a href="/countries" class="prose-link">country page</a> and use "Check from
      your country", or the checker on the home page covers all 218 countries both ways.
    </p>
  </div>
</Base>

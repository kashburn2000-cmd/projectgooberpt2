---
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { SITE } from "../config";
import { breadcrumbLd } from "../lib/seo";

const jsonLd = [
  breadcrumbLd([{ name: "Home", path: "/" }, { name: "Privacy", path: "/privacy" }]),
];
const effective = "July 2026";
---

<Base
  title={`Privacy Policy — ${SITE.SITE_NAME}`}
  description={`How ${SITE.SITE_NAME} handles cookies, advertising and data. We collect no personal information directly.`}
  jsonLd={jsonLd}
  noindex={false}
>
  <div class="mx-auto max-w-3xl px-4">
    <Breadcrumbs items={[{ name: "Home", path: "/" }, { name: "Privacy" }]} />
    <h1 class="text-balance text-3xl font-extrabold tracking-tight sm:text-4xl">Privacy policy</h1>
    <div class="prose mt-6">
      <p class="text-sm text-muted">Effective {effective}</p>
      <p>
        {SITE.SITE_NAME} ("we", "us") respects your privacy. This is a static
        reference website. We do not ask for, or directly collect, any personal
        information — there are no accounts, and no forms that store your data.
      </p>

      <h2>Cookies & consent</h2>
      <p>
        We use Google's Consent Mode. When you first visit, cookies and any
        advertising or analytics storage are set to <strong>denied</strong> by
        default. A banner lets you accept or decline non-essential cookies, and we
        remember only that choice (stored locally in your browser). You can change
        it any time by clearing your browser storage for this site.
      </p>

      <h2>Advertising</h2>
      <p>
        We may display ads served by Google AdSense. When advertising is enabled and
        you have consented, Google and its partners may use cookies to serve and
        measure ads, including personalized ads based on your prior visits. If you
        decline, Google is instructed to serve only non-personalized ads. You can
        learn more and control ad personalization at
        <a href="https://www.google.com/settings/ads" rel="nofollow noopener" target="_blank">Google Ads Settings</a>,
        and review how Google uses data at
        <a href="https://policies.google.com/technologies/partner-sites" rel="nofollow noopener" target="_blank">policies.google.com</a>.
      </p>

      <h2>Analytics</h2>
      <p>
        If analytics are enabled, they run under the same consent controls described
        above and are used only in aggregate to understand which pages are useful.
      </p>

      <h2>Data we don't collect</h2>
      <p>
        We don't sell data, we don't build advertising profiles ourselves, and we
        don't require you to identify yourself to use anything on this site.
      </p>

      <h2>Children</h2>
      <p>This site is intended for a general audience and is not directed at children under 13.</p>

      <h2>Changes</h2>
      <p>
        We may update this policy; material changes will be reflected here with a new
        effective date. Questions? <a href="/contact">Contact us</a>.
      </p>
    </div>
  </div>
</Base>

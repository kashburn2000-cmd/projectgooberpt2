---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import AdSlot from "../../components/AdSlot.astro";
import RouteFinder from "../../components/islands/RouteFinder.tsx";
import { COUNTRIES, COUNTRY_BY_CODE, type Country } from "../../data/countries";
import { PLUG_TYPES } from "../../data/plugTypes";
import { adapterAdvice, plugList, bandLabel } from "../../lib/adapter";
import { flag } from "../../lib/util";
import { breadcrumbLd, faqLd } from "../../lib/seo";
import { SITE } from "../../config";

export function getStaticPaths() {
  return COUNTRIES.map((c) => ({ params: { slug: c.slug }, props: { country: c } }));
}

const { country } = Astro.props as { country: Country };

const ORIGIN_CODES = ["US", "GB", "DE", "AU", "CA", "IN"];
const origins = ORIGIN_CODES.map((c) => COUNTRY_BY_CODE.get(c)!).filter(
  (o) => o && o.code !== country.code,
);
const verdicts = origins.map((o) => ({ origin: o, advice: adapterAdvice(o, country) }));

const us = COUNTRY_BY_CODE.get("US")!;
const usAdvice = country.code === "US" ? null : adapterAdvice(us, country);

const related = COUNTRIES.filter(
  (c) => c.subRegion === country.subRegion && c.code !== country.code,
).slice(0, 8);
const alsoPopular = ["FR", "IT", "JP", "TH", "ES", "GB"]
  .map((c) => COUNTRY_BY_CODE.get(c)!)
  .filter((c) => c && c.code !== country.code)
  .slice(0, 5);

const plugsText = plugList(country.plugs);
const bandText = bandLabel(country.voltage < 150 ? "low" : "high");

const faqs = [
  {
    q: `What plug type is used in ${country.name}?`,
    a: `${country.name} uses ${plugsText} ${country.plugs.length > 1 ? "plugs and sockets" : "plugs and sockets"}. ${country.plugs
      .map((p) => `Type ${p} has ${PLUG_TYPES[p].pins}`)
      .join(". ")}.`,
  },
  {
    q: `Is the voltage in ${country.name} 110V or 220V?`,
    a: `Mains electricity in ${country.name} is ${country.voltage} V at ${country.frequency} Hz — the ${bandText} band. Check that your device's label lists a range that includes ${country.voltage} V (most chargers say 100–240V and are fine).`,
  },
  {
    q: `Can I use my devices from the United States in ${country.name}?`,
    a: usAdvice
      ? `${usAdvice.adapterNeeded ? `You'll need a plug adapter for ${plugsText} sockets.` : `Your US plugs physically fit.`} ${usAdvice.converterNeeded ? `Because ${country.name} runs on ${country.voltage} V, single-voltage US devices (e.g. some hair dryers) also need a voltage converter, but dual-voltage electronics like phone and laptop chargers are fine with just an adapter.` : `The voltage is close to the US 120 V, so no converter is needed.`}`
      : `Yes — ${country.name} shares the United States' standards.`,
  },
  {
    q: `Do I need a voltage converter in ${country.name}?`,
    a: `Only for single-voltage devices coming from a country in the other voltage band. ${country.name} is ${country.voltage} V. Dual-voltage gear (marked 100–240V — nearly all modern electronics) never needs a converter here; single-voltage appliances from a ${country.voltage < 150 ? "220–240 V" : "100–127 V"} country do.`,
  },
];

const jsonLd = [
  breadcrumbLd([
    { name: "Home", path: "/" },
    { name: "Countries", path: "/countries" },
    { name: country.name, path: `/country/${country.slug}` },
  ]),
  faqLd(faqs),
];

const title = `Travel Adapter & Plugs in ${country.name} — Type ${country.plugs.join("/")}, ${country.voltage}V`;
const description = `${country.name} uses ${plugsText} plugs at ${country.voltage}V / ${country.frequency}Hz. See exactly which adapter and whether you need a voltage converter — from the US, UK, EU, Australia and more.`;
---

<Base title={title} description={description} image="/og/country.png" jsonLd={jsonLd}>
  <div class="mx-auto max-w-4xl px-4">
    <Breadcrumbs
      items={[
        { name: "Home", path: "/" },
        { name: "Countries", path: "/countries" },
        { name: country.name },
      ]}
    />

    <header>
      <h1 class="text-balance text-3xl font-extrabold tracking-tight sm:text-4xl">
        <span class="mr-1">{flag(country.code)}</span>
        Travel adapters & plugs in {country.name}
      </h1>
      <p class="mt-3 text-lg text-muted">
        {country.name} uses {plugsText} plugs and runs on
        <span class="font-semibold text-text">{country.voltage} V</span> at
        <span class="font-semibold text-text">{country.frequency} Hz</span>.
      </p>
    </header>

    <!-- At-a-glance facts -->
    <div class="mt-5 grid gap-3 sm:grid-cols-4">
      <div class="card">
        <div class="text-xs font-semibold uppercase tracking-wide text-muted">Plug types</div>
        <div class="mt-1 flex flex-wrap gap-1.5">
          {country.plugs.map((p) => (
            <a href={`/plug-types/${p.toLowerCase()}`} class="chip hover:border-brand-400">Type {p}</a>
          ))}
        </div>
      </div>
      <div class="card">
        <div class="text-xs font-semibold uppercase tracking-wide text-muted">Voltage</div>
        <div class="mt-1 font-mono text-xl font-bold">{country.voltage} V</div>
      </div>
      <div class="card">
        <div class="text-xs font-semibold uppercase tracking-wide text-muted">Frequency</div>
        <div class="mt-1 font-mono text-xl font-bold">{country.frequency} Hz</div>
      </div>
      <div class="card">
        <div class="text-xs font-semibold uppercase tracking-wide text-muted">Region</div>
        <a href={`/region/${country.region.toLowerCase()}`} class="mt-1 block font-semibold hover:text-brand-600">{country.region}</a>
      </div>
    </div>

    {usAdvice && (
      <div class="mt-5 flex items-start gap-3 rounded-2xl border-2 border-brand-400/40 bg-brand-500/10 p-4">
        <span class="text-2xl" aria-hidden="true">🇺🇸</span>
        <div>
          <p class="font-semibold">Coming from the United States?</p>
          <p class="text-sm text-muted">
            {usAdvice.adapterNeeded
              ? `Pack a Type ${country.plugs[0]} plug adapter.`
              : `Your plugs fit — no adapter needed.`}
            {" "}
            {usAdvice.converterNeeded
              ? `Dual-voltage electronics are fine; bring a voltage converter only for single-voltage devices.`
              : `Voltage is close to home, so no converter needed.`}
          </p>
        </div>
      </div>
    )}

    <AdSlot slot="" />

    <!-- Per-origin verdicts -->
    <section class="mt-8">
      <h2 class="text-2xl font-bold tracking-tight">Do you need an adapter for {country.name}?</h2>
      <p class="mt-2 text-muted">What travellers from the most common home countries need for {country.name}:</p>
      <div class="mt-4 overflow-x-auto rounded-2xl border border-border">
        <table class="w-full min-w-[520px] text-left text-sm">
          <thead class="bg-surface2 text-xs uppercase tracking-wide text-muted">
            <tr>
              <th class="px-4 py-3 font-semibold">Travelling from</th>
              <th class="px-4 py-3 font-semibold">Plug adapter</th>
              <th class="px-4 py-3 font-semibold">Voltage converter</th>
              <th class="px-4 py-3 font-semibold"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            {verdicts.map(({ origin, advice }) => (
              <tr class="bg-surface">
                <td class="whitespace-nowrap px-4 py-3 font-medium">{flag(origin.code)} {origin.name}</td>
                <td class="px-4 py-3">
                  {advice.adapterNeeded ? (
                    <span class="font-semibold text-volt-600">Needed</span>
                  ) : (
                    <span class="font-semibold text-good">Not needed</span>
                  )}
                </td>
                <td class="px-4 py-3">
                  {advice.converterNeeded ? (
                    <span class="text-volt-600">Single-voltage only</span>
                  ) : (
                    <span class="text-good">No</span>
                  )}
                </td>
                <td class="px-4 py-3 text-right">
                  <a class="prose-link whitespace-nowrap" href={`/adapter/${origin.slug}-to-${country.slug}`}>Details →</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Interactive: check from any country -->
    <section class="mt-8">
      <h2 class="text-xl font-bold tracking-tight">Check from your country</h2>
      <p class="mt-2 mb-3 text-muted">Not on the list? Pick your home country to see the verdict for {country.name}.</p>
      <RouteFinder client:visible src="/data/countries.slim.json" initialTo={country.code} />
    </section>

    <!-- Which adapter -->
    <section class="mt-8 rounded-2xl border border-border bg-surface p-6">
      <h2 class="text-xl font-bold tracking-tight">Which plug adapter to bring for {country.name}</h2>
      <p class="mt-2 text-muted">
        Sockets in {country.name} accept {plugsText}. An adapter labelled for any of
        these will work, and a <strong>universal travel adapter</strong> covers them
        all plus most other destinations. Adapters change plug shape only — they do
        not change the {country.voltage} V supply, so always check your device is
        rated for {country.voltage} V (or 100–240V) before plugging in.
      </p>
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        {country.plugs.map((p) => (
          <a href={`/plug-types/${p.toLowerCase()}`} class="flex items-center gap-3 rounded-xl border border-border p-3 hover:border-brand-400">
            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-lg bg-brand-600/10 font-mono font-bold text-brand-600 dark:text-brand-300">{p}</span>
            <span class="text-sm">
              <span class="font-semibold">Type {p}</span> — {PLUG_TYPES[p].standard}.
              <span class="text-muted"> {PLUG_TYPES[p].grounded ? "Grounded" : "Ungrounded"}, {PLUG_TYPES[p].pins}.</span>
            </span>
          </a>
        ))}
      </div>
    </section>

    <AdSlot slot="" />

    <!-- FAQ -->
    <section class="mt-8">
      <h2 class="text-2xl font-bold tracking-tight">{country.name} power FAQ</h2>
      <div class="mt-4 divide-y divide-border overflow-hidden rounded-2xl border border-border bg-surface">
        {faqs.map((f) => (
          <details class="group px-5 py-4">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold">
              {f.q}
              <span class="text-muted transition-transform group-open:rotate-45" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
              </span>
            </summary>
            <p class="mt-3 text-muted">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- Related links -->
    <section class="mt-10">
      <h2 class="text-lg font-bold tracking-tight">
        {related.length > 0 ? `Nearby countries` : `Popular destinations`}
      </h2>
      <div class="mt-3 flex flex-wrap gap-2">
        {(related.length > 0 ? related : alsoPopular).map((c) => (
          <a href={`/country/${c.slug}`} class="chip hover:border-brand-400">
            {flag(c.code)} {c.name}
          </a>
        ))}
      </div>
      <div class="mt-4 flex flex-wrap gap-2 text-sm">
        <a href="/countries" class="prose-link">All 218 countries →</a>
        <span class="text-border">·</span>
        <a href="/plug-types" class="prose-link">Plug types A–N →</a>
        <span class="text-border">·</span>
        <a href="/guides" class="prose-link">Travel power guides →</a>
      </div>
    </section>
  </div>
</Base>

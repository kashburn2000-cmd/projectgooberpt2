---
import { SITE, SITE_TAGLINE } from "../config";
const year = new Date().getFullYear();
const cols = [
  {
    title: "Explore",
    links: [
      { href: "/countries", label: "All countries" },
      { href: "/adapter", label: "Popular routes" },
      { href: "/plug-types", label: "Plug types A–N" },
      { href: "/guides", label: "Travel guides" },
    ],
  },
  {
    title: "Regions",
    links: [
      { href: "/region/europe", label: "Europe" },
      { href: "/region/asia", label: "Asia" },
      { href: "/region/americas", label: "Americas" },
      { href: "/region/africa", label: "Africa" },
      { href: "/region/oceania", label: "Oceania" },
    ],
  },
  {
    title: "Site",
    links: [
      { href: "/about", label: "About" },
      { href: "/methodology", label: "Methodology & sources" },
      { href: "/contact", label: "Contact" },
      { href: "/privacy", label: "Privacy" },
      { href: "/terms", label: "Terms" },
    ],
  },
];
---

<footer class="mt-20 border-t border-border bg-surface">
  <div class="mx-auto max-w-6xl px-4 py-12">
    <div class="grid gap-8 md:grid-cols-4">
      <div class="md:col-span-1">
        <div class="flex items-center gap-2 font-bold">
          <span class="grid h-7 w-7 place-items-center rounded-md bg-brand-600 text-white" aria-hidden="true">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h7l-1 8 10-12h-7l1-8Z"/></svg>
          </span>
          {SITE.SITE_NAME}
        </div>
        <p class="mt-3 max-w-xs text-sm text-muted">{SITE_TAGLINE}</p>
      </div>
      {
        cols.map((c) => (
          <div>
            <h2 class="text-xs font-semibold uppercase tracking-widest text-muted">{c.title}</h2>
            <ul class="mt-3 space-y-2 text-sm">
              {c.links.map((l) => (
                <li>
                  <a href={l.href} class="text-text/80 hover:text-brand-600 dark:hover:text-brand-300">{l.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div class="mt-10 flex flex-col gap-2 border-t border-border pt-6 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {SITE.SITE_NAME}. Reference data from public IEC / ISO sources — verify before you travel.</p>
      <p>Not affiliated with any adapter manufacturer.</p>
    </div>
  </div>
</footer>

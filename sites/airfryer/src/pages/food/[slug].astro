---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import AdSlot from "../../components/AdSlot.astro";
import CookTimer from "../../components/islands/CookTimer.tsx";
import { FOODS, CATEGORY_SLUG, fmtTime, primarySetting, type Food } from "../../data/foods";
import { breadcrumbLd, faqLd } from "../../lib/seo";

export function getStaticPaths() {
  return FOODS.map((f) => ({ params: { slug: f.slug }, props: { food: f } }));
}

const { food } = Astro.props as { food: Food };
const p = primarySetting(food);
const related = FOODS.filter((f) => f.category === food.category && f.slug !== food.slug).slice(0, 8);
const settings = [
  food.fresh && { label: "Fresh", s: food.fresh },
  food.frozen && { label: "From frozen", s: food.frozen },
].filter(Boolean) as { label: string; s: typeof p }[];

const lo = p.min[0], hi = p.min[1];
const faqs = [
  {
    q: `What temperature do you air fry ${food.name.toLowerCase()} at?`,
    a: `Air fry ${food.name.toLowerCase()} at ${p.tempF}°F (${p.tempC}°C)${food.frozen && food.fresh ? "" : food.frozen ? " straight from frozen" : ""}. ${p.shake ? "Shake or flip halfway through for even cooking." : ""}`.trim(),
  },
  {
    q: `How long does ${food.name.toLowerCase()} take in the air fryer?`,
    a: `About ${fmtTime(p.min)} at ${p.tempF}°F. Times vary by air fryer model and portion size, so check at the earlier time and add a minute or two if needed.`,
  },
  ...(food.doneness
    ? [{
        q: `How do you know when ${food.name.toLowerCase()} is done?`,
        a: `${food.doneness.label} — that's ${food.doneness.tempF}°F (${food.doneness.tempC}°C) on a food thermometer. Time is only a guide; internal temperature is what tells you it's safe.`,
      }]
    : []),
];

const jsonLd = [
  breadcrumbLd([
    { name: "Home", path: "/" },
    { name: food.category, path: `/category/${CATEGORY_SLUG[food.category]}` },
    { name: food.name, path: `/food/${food.slug}` },
  ]),
  faqLd(faqs),
  {
    "@type": "HowTo",
    name: `How to air fry ${food.name.toLowerCase()}`,
    totalTime: `PT${hi}M`,
    step: [
      { "@type": "HowToStep", text: `Set the air fryer to ${p.tempF}°F (${p.tempC}°C).` },
      { "@type": "HowToStep", text: `Add the ${food.name.toLowerCase()} in a single layer, without overcrowding.` },
      { "@type": "HowToStep", text: `Cook for ${fmtTime(p.min)}${p.shake ? ", shaking or flipping halfway" : ""}.` },
      { "@type": "HowToStep", text: food.doneness ? `Check it has reached ${food.doneness.tempF}°F (${food.doneness.tempC}°C) with a thermometer.` : `Check and add a minute or two if you'd like it crispier.` },
    ],
  },
];

const title = `Air Fryer ${food.name}: Time & Temperature (${p.tempF}°F, ${fmtTime(p.min)})`;
const description = `Air fry ${food.name.toLowerCase()} at ${p.tempF}°F for ${fmtTime(p.min)}${p.shake ? ", shaking halfway" : ""}. ${food.doneness ? `Cook to ${food.doneness.tempF}°F. ` : ""}Built-in timer, no recipe-blog scrolling.`;
---

<Base title={title} description={description} image="/og/food.png" jsonLd={jsonLd}>
  <div class="mx-auto max-w-3xl px-4">
    <Breadcrumbs
      items={[
        { name: "Home", path: "/" },
        { name: food.category, path: `/category/${CATEGORY_SLUG[food.category]}` },
        { name: food.name },
      ]}
    />

    <header>
      <h1 class="text-balance text-3xl font-extrabold tracking-tight sm:text-4xl">
        <span class="mr-1">{food.emoji}</span> Air fryer {food.name.toLowerCase()}: time & temperature
      </h1>
      {food.summary && <p class="mt-3 text-lg text-muted">{food.summary}</p>}
    </header>

    <div class="mt-5">
      <CookTimer client:load food={food} />
    </div>

    <AdSlot slot="" />

    <!-- Static settings (also for search engines) -->
    <section class="mt-6">
      <h2 class="text-xl font-bold tracking-tight">At a glance</h2>
      <div class="mt-3 overflow-x-auto rounded-2xl border border-border">
        <table class="w-full text-left text-sm">
          <thead class="bg-surface2 text-xs uppercase tracking-wide text-muted">
            <tr><th class="px-4 py-3 font-semibold">Starting from</th><th class="px-4 py-3 font-semibold">Temp</th><th class="px-4 py-3 font-semibold">Time</th><th class="px-4 py-3 font-semibold">Shake?</th></tr>
          </thead>
          <tbody class="divide-y divide-border">
            {settings.map((row) => (
              <tr class="bg-surface">
                <td class="px-4 py-3 font-medium">{row.label}</td>
                <td class="px-4 py-3 font-mono">{row.s.tempF}°F / {row.s.tempC}°C</td>
                <td class="px-4 py-3 font-mono">{fmtTime(row.s.min)}</td>
                <td class="px-4 py-3">{row.s.shake ? "Yes, halfway" : "Not needed"}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {food.doneness && (
        <p class="mt-3 rounded-xl border border-temp-500/40 bg-temp-500/10 p-3 text-sm">
          <strong>Safe internal temperature:</strong> {food.doneness.label} — {food.doneness.tempF}°F ({food.doneness.tempC}°C).
          Times are a guide; a food thermometer is the only way to be sure it's cooked through.
        </p>
      )}
    </section>

    {food.tips && food.tips.length > 0 && (
      <section class="mt-8">
        <h2 class="text-xl font-bold tracking-tight">Tips for the best {food.name.toLowerCase()}</h2>
        <ul class="mt-3 space-y-2">
          {food.tips.map((t) => (
            <li class="flex gap-3 rounded-xl border border-border bg-surface p-3 text-sm">
              <span class="mt-0.5 shrink-0 text-brand-600" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
              </span>
              <span>{t}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <AdSlot slot="" />

    <section class="mt-8">
      <h2 class="text-2xl font-bold tracking-tight">Air fryer {food.name.toLowerCase()} FAQ</h2>
      <div class="mt-3 divide-y divide-border overflow-hidden rounded-2xl border border-border bg-surface">
        {faqs.map((f) => (
          <details class="group px-5 py-4">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold">
              {f.q}
              <span class="text-muted transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mt-3 text-muted">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-lg font-bold tracking-tight">More {food.category.toLowerCase()}</h2>
      <div class="mt-3 flex flex-wrap gap-2">
        {related.map((f) => (
          <a href={`/food/${f.slug}`} class="chip hover:border-brand-400">{f.emoji} {f.name}</a>
        ))}
      </div>
      <div class="mt-4 flex flex-wrap gap-2 text-sm">
        <a href="/foods" class="prose-link">All foods →</a>
        <span class="text-border">·</span>
        <a href="/air-fryer-temperature-chart" class="prose-link">Temperature chart →</a>
        <span class="text-border">·</span>
        <a href="/guides" class="prose-link">Guides →</a>
      </div>
    </section>
  </div>
</Base>

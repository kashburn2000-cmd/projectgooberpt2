---
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import AdSlot from "../components/AdSlot.astro";
import { foodsByCategory, FOODS, primarySetting, fmtTime } from "../data/foods";
import { breadcrumbLd } from "../lib/seo";

const cats = foodsByCategory();
const jsonLd = [breadcrumbLd([{ name: "Home", path: "/" }, { name: "All foods", path: "/foods" }])];
---

<Base
  title="Air Fryer Cook Times — Every Food, A to Z"
  description={`Air fryer times and temperatures for ${FOODS.length}+ foods, from frozen fries to whole chicken. Filter to find yours, each with a built-in timer.`}
  image="/og/chart.png"
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-5xl px-4">
    <Breadcrumbs items={[{ name: "Home", path: "/" }, { name: "All foods" }]} />
    <h1 class="text-balance text-3xl font-extrabold tracking-tight sm:text-4xl">Every air fryer food</h1>
    <p class="mt-3 max-w-2xl text-lg text-muted">All {FOODS.length} foods with times and temperatures. Filter below, then tap for a timer.</p>

    <div class="mt-6">
      <label class="relative block">
        <span class="sr-only">Filter foods</span>
        <input id="food-filter" type="search" placeholder="Filter foods…" autocomplete="off" class="w-full rounded-xl border border-border bg-surface px-4 py-3 pl-10 shadow-sm focus:border-brand-500" />
        <svg class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-muted" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      </label>
      <p id="filter-empty" hidden class="mt-4 text-muted">No foods match that search.</p>
    </div>

    <AdSlot slot="" />

    {
      cats.map((c) => (
        <section class="mt-8 cat-group" data-cat={c.category}>
          <h2 class="text-xl font-bold tracking-tight">{c.category}</h2>
          <div class="mt-3 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
            {c.foods.map((f) => {
              const p = primarySetting(f);
              return (
                <a href={`/food/${f.slug}`} class="food-item flex items-center justify-between gap-2 rounded-xl border border-border bg-surface px-4 py-2.5 hover:border-brand-400" data-name={(f.name + " " + (f.aliases || []).join(" ")).toLowerCase()}>
                  <span class="truncate font-medium">{f.emoji} {f.name}</span>
                  <span class="shrink-0 font-mono text-xs text-muted">{p.tempF}°F · {fmtTime(p.min)}</span>
                </a>
              );
            })}
          </div>
        </section>
      ))
    }
  </div>

  <script is:inline>
    (function () {
      var input = document.getElementById("food-filter");
      if (!input) return;
      var items = Array.prototype.slice.call(document.querySelectorAll(".food-item"));
      var groups = Array.prototype.slice.call(document.querySelectorAll(".cat-group"));
      var empty = document.getElementById("filter-empty");
      input.addEventListener("input", function () {
        var q = input.value.trim().toLowerCase();
        var any = false;
        items.forEach(function (el) {
          var m = !q || el.getAttribute("data-name").indexOf(q) !== -1;
          el.hidden = !m; if (m) any = true;
        });
        groups.forEach(function (g) { g.hidden = g.querySelectorAll(".food-item:not([hidden])").length === 0; });
        if (empty) empty.hidden = any;
      });
    })();
  </script>
</Base>

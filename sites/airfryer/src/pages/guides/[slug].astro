---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import AdSlot from "../../components/AdSlot.astro";
import { getCollection, render } from "astro:content";
import { breadcrumbLd, abs } from "../../lib/seo";
import { SITE } from "../../config";

export async function getStaticPaths() {
  const guides = await getCollection("guides");
  return guides.map((g) => ({ params: { slug: g.id }, props: { guide: g } }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
const related = (await getCollection("guides"))
  .filter((g) => g.id !== guide.id)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

const updated = guide.data.updated.toISOString().slice(0, 10);
const jsonLd = [
  breadcrumbLd([
    { name: "Home", path: "/" },
    { name: "Guides", path: "/guides" },
    { name: guide.data.title, path: `/guides/${guide.id}` },
  ]),
  {
    "@type": "Article",
    headline: guide.data.title,
    description: guide.data.description,
    dateModified: guide.data.updated.toISOString(),
    author: { "@type": "Organization", name: SITE.SITE_NAME, url: SITE.SITE_URL },
    publisher: { "@type": "Organization", name: SITE.SITE_NAME },
    mainEntityOfPage: abs(`/guides/${guide.id}`),
  },
];
---

<Base
  title={`${guide.data.title} — ${SITE.SITE_NAME}`}
  description={guide.data.description}
  type="article"
  image="/og/guide.png"
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-3xl px-4">
    <Breadcrumbs
      items={[
        { name: "Home", path: "/" },
        { name: "Guides", path: "/guides" },
        { name: guide.data.title },
      ]}
    />

    <article>
      <header>
        <div class="text-xs font-semibold uppercase tracking-wide text-brand-600 dark:text-brand-300">
          {guide.data.category}
        </div>
        <h1 class="mt-1 text-balance text-3xl font-extrabold tracking-tight sm:text-4xl">
          {guide.data.title}
        </h1>
        <p class="mt-3 text-lg text-muted">{guide.data.description}</p>
        <p class="mt-2 text-sm text-muted">
          Last reviewed <time datetime={updated}>{updated}</time>
        </p>
      </header>

      <AdSlot slot="" />

      <div class="prose mt-6">
        <Content />
      </div>
    </article>

    <div class="mt-8 rounded-2xl border border-border bg-surface p-5">
      <p class="text-sm text-muted">
        Need a specific time? <a href="/" class="prose-link">Search your food</a> —
        the temperature, the time, and a built-in timer, no scrolling.
      </p>
    </div>

    <AdSlot slot="" />

    <section class="mt-8">
      <h2 class="text-lg font-bold tracking-tight">More guides</h2>
      <div class="mt-3 grid gap-2 sm:grid-cols-2">
        {
          related.map((g) => (
            <a href={`/guides/${g.id}`} class="rounded-xl border border-border bg-surface px-4 py-3 text-sm font-medium hover:border-brand-400">
              {g.data.title}
            </a>
          ))
        }
      </div>
    </section>
  </div>
</Base>

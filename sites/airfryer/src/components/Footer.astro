---
import { SITE, SITE_TAGLINE } from "../config";
import { foodsByCategory } from "../data/foods";
const cats = foodsByCategory();
const Mark = `<svg width="15" height="15" viewBox="0 0 32 32" fill="none"><path d="M6 11c1.6-1.6 3-1.6 3.5 0s1.9 1.6 3.5 0 3-1.6 3.5 0 1.9 1.6 3.5 0" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><rect x="5" y="14" width="17" height="11" rx="2.5" fill="none" stroke="currentColor" stroke-width="2.2"/></svg>`;
const cols = [
  {
    title: "Cook times",
    links: cats.slice(0, 5).map((c) => ({ href: `/category/${c.slug}`, label: c.category })),
  },
  {
    title: "Reference",
    links: [
      { href: "/foods", label: "All foods" },
      { href: "/air-fryer-temperature-chart", label: "Temperature chart" },
      { href: "/guides", label: "Guides" },
    ],
  },
  {
    title: "Site",
    links: [
      { href: "/about", label: "About" },
      { href: "/methodology", label: "Methodology & safety" },
      { href: "/contact", label: "Contact" },
      { href: "/privacy", label: "Privacy" },
      { href: "/terms", label: "Terms" },
    ],
  },
];
---

<footer class="mt-20 border-t border-border bg-surface">
  <div class="mx-auto max-w-6xl px-4 py-12">
    <div class="grid gap-8 md:grid-cols-4">
      <div class="md:col-span-1">
        <div class="flex items-center gap-2 font-bold">
          <span class="grid h-7 w-7 place-items-center rounded-md bg-brand-600 text-white" aria-hidden="true" set:html={Mark}></span>
          {SITE.SITE_NAME}
        </div>
        <p class="mt-3 max-w-xs text-sm text-muted">{SITE_TAGLINE}</p>
      </div>
      {
        cols.map((c) => (
          <div>
            <h2 class="text-xs font-semibold uppercase tracking-widest text-muted">{c.title}</h2>
            <ul class="mt-3 space-y-2 text-sm">
              {c.links.map((l) => (
                <li><a href={l.href} class="text-text/80 hover:text-brand-700 dark:hover:text-brand-300">{l.label}</a></li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div class="mt-10 flex flex-col gap-2 border-t border-border pt-6 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© {new Date().getFullYear()} {SITE.SITE_NAME}. Times are guidance — always cook to a safe internal temperature.</p>
      <p>Not affiliated with any air fryer manufacturer.</p>
    </div>
  </div>
</footer>

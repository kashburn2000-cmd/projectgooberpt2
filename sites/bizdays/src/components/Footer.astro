---
import { SITE, SITE_TAGLINE } from "../config";
import { popularCountries } from "../data/countries";
const year = new Date().getFullYear();
const popular = popularCountries().slice(0, 8);
const CalIcon = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4.5" width="18" height="16" rx="2"/><path d="M3 9h18M8 2.5v4M16 2.5v4"/><path d="m9 14 2 2 4-4"/></svg>`;
const cols = [
  {
    title: "Tools",
    links: [
      { href: "/", label: "Business-day calculator" },
      { href: "/holidays", label: "Public holidays" },
      { href: "/business-days", label: "Working days by country" },
      { href: "/countries", label: "All countries" },
      { href: "/guides", label: "Guides" },
    ],
  },
  {
    title: "Popular",
    links: popular.map((c) => ({ href: `/holidays/${c.slug}`, label: c.name })),
  },
  {
    title: "Site",
    links: [
      { href: "/about", label: "About" },
      { href: "/methodology", label: "Methodology & sources" },
      { href: "/contact", label: "Contact" },
      { href: "/privacy", label: "Privacy" },
      { href: "/terms", label: "Terms" },
    ],
  },
];
---

<footer class="mt-20 border-t border-border bg-surface">
  <div class="mx-auto max-w-6xl px-4 py-12">
    <div class="grid gap-8 md:grid-cols-4">
      <div class="md:col-span-1">
        <div class="flex items-center gap-2 font-bold">
          <span class="grid h-7 w-7 place-items-center rounded-md bg-brand-600 text-white" aria-hidden="true" set:html={CalIcon}></span>
          {SITE.SITE_NAME}
        </div>
        <p class="mt-3 max-w-xs text-sm text-muted">{SITE_TAGLINE}</p>
      </div>
      {
        cols.map((c) => (
          <div>
            <h2 class="text-xs font-semibold uppercase tracking-widest text-muted">{c.title}</h2>
            <ul class="mt-3 space-y-2 text-sm">
              {c.links.map((l) => (
                <li>
                  <a href={l.href} class="text-text/80 hover:text-brand-600 dark:hover:text-brand-300">{l.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div class="mt-10 flex flex-col gap-2 border-t border-border pt-6 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {SITE.SITE_NAME}. Public-holiday data from open sources — verify official dates locally before relying on them.</p>
      <p>Weekends and holidays vary by region and can change.</p>
    </div>
  </div>
</footer>

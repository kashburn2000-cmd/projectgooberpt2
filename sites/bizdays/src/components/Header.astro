---
import { SITE } from "../config";
const nav = [
  { href: "/holidays", label: "Public holidays" },
  { href: "/business-days", label: "Business days" },
  { href: "/countries", label: "Countries" },
  { href: "/guides", label: "Guides" },
];
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + "/");
const CalIcon = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4.5" width="18" height="16" rx="2"/><path d="M3 9h18M8 2.5v4M16 2.5v4"/><path d="m9 14 2 2 4-4"/></svg>`;
---

<header class="sticky top-0 z-40 border-b border-border bg-bg/85 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <a href="/" class="flex items-center gap-2 font-bold tracking-tight">
      <span class="grid h-8 w-8 place-items-center rounded-lg bg-brand-600 text-white" aria-hidden="true" set:html={CalIcon}></span>
      <span class="text-lg">{SITE.SITE_NAME}</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {
        nav.map((n) => (
          <a
            href={n.href}
            class:list={[
              "rounded-lg px-3 py-2 text-sm font-medium transition-colors hover:bg-surface2",
              isActive(n.href) ? "text-brand-600 dark:text-brand-300" : "text-muted",
            ]}
          >
            {n.label}
          </a>
        ))
      }
      <button id="theme-toggle" type="button" class="ml-1 grid h-9 w-9 place-items-center rounded-lg border border-border hover:bg-surface2" aria-label="Toggle dark mode">
        <svg class="hidden dark:block" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"/></svg>
        <svg class="block dark:hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"/></svg>
      </button>
    </nav>

    <details class="relative md:hidden">
      <summary class="grid h-9 w-9 cursor-pointer list-none place-items-center rounded-lg border border-border" aria-label="Menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </summary>
      <div class="absolute right-0 mt-2 w-52 rounded-xl border border-border bg-surface p-2 shadow-lg">
        {nav.map((n) => (
          <a href={n.href} class="block rounded-lg px-3 py-2 text-sm hover:bg-surface2">{n.label}</a>
        ))}
        <button id="theme-toggle-m" type="button" class="mt-1 flex w-full items-center gap-2 rounded-lg px-3 py-2 text-sm hover:bg-surface2">Toggle theme</button>
      </div>
    </details>
  </div>
</header>

<script is:inline>
  (function () {
    function toggle() {
      var d = document.documentElement.classList.toggle("dark");
      try { localStorage.setItem("theme", d ? "dark" : "light"); } catch (e) {}
    }
    ["theme-toggle", "theme-toggle-m"].forEach(function (id) {
      var el = document.getElementById(id);
      if (el) el.addEventListener("click", toggle);
    });
  })();
</script>

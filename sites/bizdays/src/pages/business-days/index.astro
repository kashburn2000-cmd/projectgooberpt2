---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import AdSlot from "../../components/AdSlot.astro";
import { countriesByRegion, CURRENT_YEAR } from "../../data/countries";
import { holidaySet } from "../../data/holidays";
import { businessDaysInYear } from "../../lib/bizdays";
import { flag } from "../../lib/util";
import { breadcrumbLd } from "../../lib/seo";

const groups = countriesByRegion();
const workingDays = (code: string, weekend: number[]) =>
  businessDaysInYear(CURRENT_YEAR, weekend, holidaySet(code, [CURRENT_YEAR])).businessDays;
const jsonLd = [breadcrumbLd([{ name: "Home", path: "/" }, { name: "Business days", path: "/business-days" }])];
---

<Base
  title={`Working Days by Country ${CURRENT_YEAR} — Business Day Calculators`}
  description={`How many working days in ${CURRENT_YEAR}, for every country. Open any country for a business-day calculator that includes weekends and public holidays.`}
  image="/og/business.png"
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-5xl px-4">
    <Breadcrumbs items={[{ name: "Home", path: "/" }, { name: "Business days" }]} />
    <h1 class="text-balance text-3xl font-extrabold tracking-tight sm:text-4xl">Working days by country, {CURRENT_YEAR}</h1>
    <p class="mt-3 max-w-2xl text-lg text-muted">The number of working days this year in each country — and a full business-day calculator for each.</p>

    <AdSlot slot="" />

    {
      groups.map((g) => (
        <section class="mt-8">
          <h2 class="text-xl font-bold tracking-tight">{g.region}</h2>
          <div class="mt-3 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
            {g.countries.map((c) => (
              <a href={`/business-days/${c.slug}`} class="flex items-center justify-between gap-2 rounded-xl border border-border bg-surface px-4 py-2.5 hover:border-brand-400">
                <span class="truncate font-medium"><span class="mr-1">{flag(c.code)}</span>{c.name}</span>
                <span class="shrink-0 font-mono text-xs text-work-600">{workingDays(c.code, c.weekend)} days</span>
              </a>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</Base>

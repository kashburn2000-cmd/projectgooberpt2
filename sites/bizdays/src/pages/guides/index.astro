---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import AdSlot from "../../components/AdSlot.astro";
import { getCollection } from "astro:content";
import { breadcrumbLd } from "../../lib/seo";

const guides = (await getCollection("guides")).sort(
  (a, b) => a.data.order - b.data.order,
);
const jsonLd = [
  breadcrumbLd([{ name: "Home", path: "/" }, { name: "Guides", path: "/guides" }]),
];
---

<Base
  title="Business Day & Working Day Guides"
  description="Plain-English guides to business days: what counts as a working day, net payment terms, how holidays and weekends differ by country, and how to calculate deadlines."
  image="/og/guide.png"
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-4xl px-4">
    <Breadcrumbs items={[{ name: "Home", path: "/" }, { name: "Guides" }]} />
    <h1 class="text-balance text-3xl font-extrabold tracking-tight sm:text-4xl">
      Business-day guides
    </h1>
    <p class="mt-3 max-w-2xl text-lg text-muted">
      Working days, net payment terms, and how holidays and weekends really work
      around the world.
    </p>

    <AdSlot slot="" />

    <div class="mt-6 grid gap-3 sm:grid-cols-2">
      {
        guides.map((g) => (
          <a href={`/guides/${g.id}`} class="card group hover:border-brand-400">
            <div class="text-xs font-semibold uppercase tracking-wide text-brand-600 dark:text-brand-300">
              {g.data.category}
            </div>
            <h2 class="mt-1 text-lg font-bold tracking-tight group-hover:text-brand-600 dark:group-hover:text-brand-300">
              {g.data.title}
            </h2>
            <p class="mt-1 text-sm text-muted">{g.data.description}</p>
          </a>
        ))
      }
    </div>
  </div>
</Base>

---
import Base from "../layouts/Base.astro";
import AdSlot from "../components/AdSlot.astro";
import BusinessDayCalculator from "../components/islands/BusinessDayCalculator.tsx";
import { SITE, SITE_TAGLINE } from "../config";
import { COUNTRIES, YEARS, CURRENT_YEAR, popularCountries } from "../data/countries";
import { getHolidays } from "../data/holidays";
import { flag, formatDate, weekendLabel } from "../lib/util";

const slim = COUNTRIES.map(({ code, name, slug, weekend }) => ({ code, name, slug, weekend }));

const today = new Date().toISOString().slice(0, 10);
function nextHoliday(code: string) {
  for (const y of YEARS) for (const h of getHolidays(code, y)) if (h.date >= today) return h;
  return null;
}
const upcoming = popularCountries()
  .slice(0, 8)
  .map((c) => ({ c, h: nextHoliday(c.code) }))
  .filter((x) => x.h);

const faqs = [
  {
    q: "What counts as a business day?",
    a: "A business day (or working day) is any day that isn't a weekend or a public holiday. In most countries the weekend is Saturday and Sunday, but not everywhere — across much of the Middle East it's Friday and Saturday, and a few countries use a single day. This tool uses the typical weekend for each country, and you can change it.",
  },
  {
    q: "Does the calculation include the start date?",
    a: "For 'days between', we count every working day from the start date through to the end date, inclusive of both. For 'add business days', counting begins the day after your start date — so 1 business day after a Friday (with a Sat–Sun weekend) is the following Monday.",
  },
  {
    q: "How are public holidays handled?",
    a: `We exclude each country's national public holidays, drawn from an open, maintained dataset covering ${YEARS[0]}–${YEARS[YEARS.length - 1]}. Regional or local holidays (state, provincial, or religious observances that aren't nationwide) can differ, so treat the result as a close estimate.`,
  },
  {
    q: "Can I trust these dates for legal or contractual deadlines?",
    a: "Use them for planning, not as legal advice. Holiday lists and weekend definitions vary by region and occasionally change. For binding deadlines (court filings, payment terms, SLAs), confirm against the official government calendar for the jurisdiction.",
  },
];

const jsonLd = [
  { "@type": "WebSite", name: SITE.SITE_NAME, url: SITE.SITE_URL, description: SITE_TAGLINE },
  {
    "@type": "WebApplication",
    name: SITE.SITE_NAME,
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  },
  {
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];
---

<Base
  title={`${SITE.SITE_NAME} — Business Day & Working Day Calculator by Country`}
  description={SITE_TAGLINE}
  path="/"
  jsonLd={jsonLd}
>
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 -z-10 opacity-70"
      style="background:radial-gradient(60% 60% at 50% 0%, color-mix(in oklab, var(--color-brand-500) 22%, transparent), transparent)"
      aria-hidden="true"
    >
    </div>
    <div class="mx-auto max-w-4xl px-4 pb-6 pt-12 text-center sm:pt-16">
      <span class="chip mb-4">📅 {COUNTRIES.length} countries · public-holiday aware</span>
      <h1 class="text-balance text-4xl font-extrabold tracking-tight sm:text-5xl">
        Business day <span class="text-brand-600 dark:text-brand-400">calculator</span>
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-muted">
        Count working days between two dates, or add business days to a date — with
        each country's real weekends and public holidays factored in.
      </p>
    </div>
    <div class="mx-auto max-w-3xl px-4 pb-4">
      <div class="min-h-[430px]">
        <BusinessDayCalculator client:only="preact" countries={slim} years={YEARS} initialCode="US" />
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4">
    <AdSlot slot="" />

    <!-- Upcoming holidays -->
    <section class="mt-10">
      <div class="flex items-end justify-between">
        <h2 class="text-2xl font-bold tracking-tight">Next public holiday</h2>
        <a href="/holidays" class="prose-link text-sm font-medium">All countries →</a>
      </div>
      <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {
          upcoming.map(({ c, h }) => (
            <a href={`/holidays/${c.slug}`} class="card hover:border-brand-400">
              <div class="flex items-center gap-2 font-semibold">
                <span>{flag(c.code)}</span> {c.name}
              </div>
              <div class="mt-2 text-sm">{h!.name}</div>
              <div class="mt-0.5 font-mono text-xs text-muted">{formatDate(h!.date)}</div>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Popular countries -->
    <section class="mt-14">
      <div class="flex items-end justify-between">
        <h2 class="text-2xl font-bold tracking-tight">Holidays & working days by country</h2>
        <a href="/countries" class="prose-link text-sm font-medium">All {COUNTRIES.length} →</a>
      </div>
      <div class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-5">
        {
          popularCountries().map((c) => (
            <a href={`/holidays/${c.slug}`} class="flex items-center gap-2 rounded-xl border border-border bg-surface px-3 py-2.5 text-sm font-medium hover:border-brand-400">
              <span>{flag(c.code)}</span>
              <span class="truncate">{c.name}</span>
            </a>
          ))
        }
      </div>
    </section>

    <!-- How it works -->
    <section class="mt-14 grid gap-6 rounded-3xl border border-border bg-surface p-6 md:grid-cols-2 md:p-8">
      <div>
        <h2 class="text-2xl font-bold tracking-tight">Working days, done right</h2>
        <p class="mt-3 text-muted">Most "business day" calculators only skip Saturdays and Sundays. That quietly breaks in two ways:</p>
      </div>
      <ul class="space-y-4">
        <li class="flex gap-3">
          <span class="mt-1 grid h-7 w-7 shrink-0 place-items-center rounded-lg bg-brand-600/10 font-mono text-sm font-bold text-brand-600 dark:text-brand-300">1</span>
          <p><strong>Public holidays.</strong> We subtract each country's national holidays, so a "net 10 business days" invoice date is actually right.</p>
        </li>
        <li class="flex gap-3">
          <span class="mt-1 grid h-7 w-7 shrink-0 place-items-center rounded-lg bg-holiday-500/10 font-mono text-sm font-bold text-holiday-600">2</span>
          <p><strong>Local weekends.</strong> Much of the Middle East rests Friday–Saturday. We default to the right weekend per country — and let you change it.</p>
        </li>
      </ul>
    </section>

    <AdSlot slot="" />

    <!-- FAQ -->
    <section class="mt-14">
      <h2 class="text-2xl font-bold tracking-tight">Frequently asked</h2>
      <div class="mt-4 divide-y divide-border overflow-hidden rounded-2xl border border-border bg-surface">
        {
          faqs.map((f) => (
            <details class="group px-5 py-4">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold">
                {f.q}
                <span class="text-muted transition-transform group-open:rotate-45" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
                </span>
              </summary>
              <p class="mt-3 text-muted">{f.a}</p>
            </details>
          ))
        }
      </div>
    </section>
  </div>
</Base>
